# Firebase Configuration Template for HabitFlow
# -------------------------------------------------------------
# Instructions:
# 1. Go to Firebase Console (https://console.firebase.google.com/)
# 2. Select or create a project
# 3. Enable Email/Password in: Authentication -> Sign-in method -> Email/Password
# 4. Under Project Settings -> General -> Your apps, create a Web App and copy your config values here.
# 5. Create a file named .env in the Habitflow/ root and paste these variables with your real values.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
